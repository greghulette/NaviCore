# Arduino build artifacts
build/
*.hex
*.bin
*.elf
*.map

# Exception: hosted assets in /model/ (e.g. transmitter model files)
!model/*.bin

# Exception: firmware images served to the in-browser flasher (built by
# .github/workflows/build-firmware.yml and committed back to main).
!firmware/*.bin

# Editor / IDE
.vscode/
.idea/
*.code-workspace
*.swp
*.bak
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Claude Code worktree / session state
.claude/
PCB/NaviCore_V1/.history/

# FrSky Ethos Simulator working files. The simulator writes into model/ and
# creates deeply-recursive copies of itself (model/Ethos Simulator/<ver>/Ethos
# Simulator/<ver>/...). 208 MB of it was committed by accident in Aug 2026 via
# `git add -A`; the .wasm payloads alone are 20-40 MB each. Only the hand-authored
# transmitter model files below belong in the repo.
model/Ethos Simulator/
*.wasm

# Local working notes — never published
.local/
